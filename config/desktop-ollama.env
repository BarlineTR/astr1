# Live desktop profile: real ROS microphone/camera, local STT and Ollama.
USE_REALTIME=false
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_ENABLED=false
STT_ENGINE=faster-whisper
STT_FW_MODEL=small
STT_FW_DEVICE=cpu
STT_FW_COMPUTE_TYPE=int8
LOCAL_GEMMA_BACKEND=ollama
LOCAL_GEMMA_BASE_URL=http://127.0.0.1:11434
LOCAL_GEMMA_MODEL=gemma4:e2b
LOCAL_GEMMA_TIMEOUT_S=30
LOCAL_GEMMA_FIRST_TOKEN_TIMEOUT_S=30
LOCAL_GEMMA_N_PREDICT=100
AUDIO_INPUT_DEVICE=pulse
AUDIO_OUTPUT_DEVICE=pulse
AUDIO_INPUT_CHANNELS=1
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=tr-TR-AhmetNeural
PERSONA=neutral
ASTRO_PROACTIVE_SPEECH=0
