# Yerel geliştirme ayarları örneği.
#
# Kopyalayın:  cp apps/site/.env.example apps/site/.env.local
#
# Dosya apps/site içinde durur, kökte değil: Next ortam dosyalarını uygulama
# dizininden okuyor ve kökteki bir .env.local derleme sırasında görülmüyordu.
#
# .env.local depoya girmez (.gitignore).

# ── Veritabanı ──
# Yerelde: docker compose -f docker/compose.yaml up -d
# Port 5433, çünkü 5432'de başka bir Postgres olabilir ve sessizce yanlış
# veritabanına bağlanmak bağlanamamaktan kötü.
DATABASE_URL=postgres://astro:astro@localhost:5433/astro

# ── Oturum ──
# Üretimde rastgele ve gizli olmalı: openssl rand -base64 32
BETTER_AUTH_SECRET=gelistirme-icin-sabit-deger-uretimde-degistirin
BETTER_AUTH_URL=http://localhost:3000

# ── Site ──
# Canonical, sitemap ve OG adresleri buradan türetilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── E-posta (Resend) ──
# Boş bırakılırsa e-postalar konsola yazılır ve bunu açıkça söyler.
# Geliştirmede sessizce başarısız olan bir e-posta, çalıştığını sanmaktan kötü.
RESEND_API_KEY=
EPOSTA_GONDEREN="ASTRO <bildirim@example.invalid>"
EPOSTA_ALICI=iletisim@example.invalid

# ── Ağ geçidi ──
# Ağ geçidi ile site arasındaki sunucudan sunucuya doğrulama çağrısını imzalar.
# Boşsa doğrulama ucu tamamen kapalıdır — açık bırakmak doğrulamayı herkese
# açmak olurdu. Üretimde: openssl rand -base64 32
GATEWAY_SHARED_SECRET=gelistirme-gecit-sirri-uretimde-degistirin

# Tarayıcının ve robot ajanının bağlanacağı ağ geçidi adresi.
NEXT_PUBLIC_GECIT_URL=ws://localhost:8420

# ── Ödeme (iyzico) ──
# Anahtarlar boşken sahte sağlayıcı kullanılır: bütün sipariş akışı çalışır ama
# para hareket etmez ve panelde bunu söyleyen bir uyarı çizilir.
#
# Sandbox anahtarı almak için: https://sandbox-merchant.iyzipay.com/auth/register
# Ayarlar > Merchant Ayarları > API Anahtarları
#
# Sandbox:  https://sandbox-api.iyzipay.com
# Canlı:    https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com
