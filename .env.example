# ASTRO V1 — Yapılandırma şablonu
#
# Kullanım:  cp .env.example .env   ve OPENAI_API_KEY'i doldurun.
#
# ⚠️ HER ANAHTAR YALNIZCA BİR KEZ TANIMLANMALI. python-dotenv aynı anahtar birden
# çok kez geçerse SONUNCUSUNU kullanır; tekrar eden tanımlar üstteki ayarları
# sessizce ezer. Yeni ayar eklerken mevcut satırı DEĞİŞTİRİN, sona eklemeyin.
#
# Bu dosya kaynak koddan (AST ile) üretilmiştir: aşağıdaki her anahtar gerçekten
# okunuyor ve "varsayılan" koddaki gerçek değerdir. Boş bırakılan her satır
# koddaki varsayılana düşer.

# ==========================================================================
# 🤖 GENEL — Mod, uyandırma sözcüğü, oturum ve hafıza
# ==========================================================================
#   varsayılan: '0'   ·   okuyan: audio_output_manager.py
ASTRO_MOCK_AUDIO='0'

#   varsayılan: '16.0'   ·   okuyan: ai_brain_node.py
CONVERSATION_TIMEOUT='16.0'

#   varsayılan: 'Misafir'   ·   okuyan: ai_brain_node.py
DEFAULT_USER_NAME='Misafir'

#   varsayılan: 'Bitlis'   ·   okuyan: ai_brain_node.py
DEFAULT_WEATHER_CITY='Bitlis'

#   varsayılan: '0.65'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
ECHO_MUTE_COOLDOWN_S='0.65'

#   varsayılan: 'true'   ·   okuyan: ai_brain_node.py, astro_realtime_node.py
ENABLE_IDLE_LEARNING='true'

#   varsayılan: '4'   ·   okuyan: astro_realtime_node.py
MAX_VISION_REQUESTS_PER_MINUTE='4'

# Kalıcı hafıza dosyası. Boşsa ros2_ws/astro_memory.json (git'te takip EDİLMEZ; tohum: astro_memory.seed.json).
#   varsayılan: ''   ·   okuyan: memory_manager.py
MEMORY_FILE_PATH=''

#   varsayılan: 'playful'   ·   okuyan: astro_realtime_node.py
PERSONA='playful'

#   varsayılan: 'hey astro'   ·   okuyan: ai_brain_node.py
WAKE_WORD='hey astro'


# ==========================================================================
# 🧠 LLM — Sohbet motoru, sağlayıcı sırası ve API anahtarları
# ==========================================================================
#   varsayılan: ''   ·   okuyan: ai_brain_node.py, openai_tts_engine.py
AI_API_KEY=""

#   varsayılan: ''   ·   okuyan: ai_brain_node.py, astro_realtime_node.py
GEMINI_API_KEY=""

#   varsayılan: 'gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-flash'   ·   okuyan: ai_brain_node.py
GEMINI_TEXT_MODELS='gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-flash'

#   varsayılan: '12'   ·   okuyan: ai_brain_node.py
GEMINI_TIMEOUT_S='12'

#   varsayılan: ''   ·   okuyan: ai_brain_node.py, astro_realtime_node.py
GROQ_API_KEY=""

#   varsayılan: '30.0'   ·   okuyan: circuit_breaker.py
GROQ_COOLDOWN_S='30.0'

# "false" -> yalnızca LLM_PROVIDER denenir, yedeğe düşülmez.
#   varsayılan: 'true'   ·   okuyan: ai_brain_node.py
LLM_FALLBACK_ENABLED='true'

#   varsayılan: '300'   ·   okuyan: ai_brain_node.py
LLM_MAX_TOKENS='300'

#   varsayılan: 'llama-3.3-70b-versatile'   ·   okuyan: ai_brain_node.py
LLM_MODEL='llama-3.3-70b-versatile'

# Birincil sağlayıcı: groq | gemini | openai. Yerleşik zincir groq->gemini->openai; seçilenden öncekiler atlanır, sonrakiler yedek kalır. Boş = tüm zincir.
#   varsayılan: ''   ·   okuyan: ai_brain_node.py
LLM_PROVIDER=''

#   varsayılan: '0.55'   ·   okuyan: ai_brain_node.py
LLM_TEMPERATURE='0.55'

# ZORUNLU (OpenAI yığını için). STT, LLM ve TTS bu anahtarı kullanır.
#   varsayılan: ''   ·   okuyan: ai_brain_node.py, astro_realtime_node.py
OPENAI_API_KEY=""

#   varsayılan: '30.0'   ·   okuyan: circuit_breaker.py
OPENAI_COOLDOWN_S='30.0'


# ==========================================================================
# 🎤 STT — Konuşmadan metne
# ==========================================================================
# "openai" | "groq" | "faster-whisper". "faster-whisper" DIŞINDAKİ her değer yerel modelin yüklenmesini engeller.
#   varsayılan: 'faster-whisper'   ·   okuyan: speech_recognition_node.py
STT_ENGINE='faster-whisper'

#   varsayılan: 'float16'   ·   okuyan: speech_recognition_node.py
STT_FW_COMPUTE_TYPE='float16'

#   varsayılan: 'int8'   ·   okuyan: speech_recognition_node.py
STT_FW_CPU_COMPUTE_TYPE='int8'

#   varsayılan: 'base'   ·   okuyan: speech_recognition_node.py
STT_FW_CPU_MODEL='base'

#   varsayılan: 'cuda'   ·   okuyan: speech_recognition_node.py
STT_FW_DEVICE='cuda'

#   varsayılan: 'large-v2'   ·   okuyan: speech_recognition_node.py
STT_FW_MODEL='large-v2'


# ==========================================================================
# 🔊 TTS — Metinden konuşmaya
# ==========================================================================
#   varsayılan: ''   ·   okuyan: audio_capture_node.py, audio_stream_node.py
AUDIO_INPUT_DEVICE=''

#   varsayılan: 'auto'   ·   okuyan: audio_output_manager.py
AUDIO_OUTPUT_BACKEND='auto'

#   varsayılan: ''   ·   okuyan: audio_stream_node.py, tts_node.py
AUDIO_OUTPUT_DEVICE=''

#   varsayılan: '3'   ·   okuyan: astro_realtime_node.py
BARGE_IN_MIN_CONSECUTIVE_FRAMES='3'

#   varsayılan: '2800'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
BARGE_IN_MIN_PEAK='2800'

#   varsayılan: '1200.0'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
BARGE_IN_MIN_RMS='1200.0'

#   varsayılan: '3.5'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
BARGE_IN_NOISE_MULTIPLIER='3.5'

#   varsayılan: '6'   ·   okuyan: astro_realtime_node.py
BARGE_IN_PLAYBACK_CONSECUTIVE_FRAMES='6'

#   varsayılan: '14000'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
BARGE_IN_PLAYBACK_MIN_PEAK='14000'

#   varsayılan: '4500.0'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
BARGE_IN_PLAYBACK_MIN_RMS='4500.0'

#   varsayılan: 'true'   ·   okuyan: astro_realtime_node.py
EDGE_TTS_ENABLED='true'

#   varsayılan: self.DEFAULT_RATE   ·   okuyan: edge_tts_engine.py
EDGE_TTS_RATE=""

#   varsayılan: str(self.DEFAULT_TIMEOUT_S)   ·   okuyan: edge_tts_engine.py, tts_router.py
EDGE_TTS_TIMEOUT_S=""

#   varsayılan: self.DEFAULT_VOICE   ·   okuyan: edge_tts_engine.py
EDGE_TTS_VOICE=""

#   varsayılan: ''   ·   okuyan: astro_realtime_node.py, elevenlabs_engine.py
ELEVENLABS_API_KEY=""

#   varsayılan: 'false'   ·   okuyan: astro_realtime_node.py, elevenlabs_engine.py
ELEVENLABS_ENABLED='false'

#   varsayılan: 'eleven_flash_v2_5'   ·   okuyan: astro_realtime_node.py, elevenlabs_engine.py
ELEVENLABS_MODEL='eleven_flash_v2_5'

#   varsayılan: ''   ·   okuyan: astro_realtime_node.py, elevenlabs_engine.py
ELEVENLABS_VOICE_ID=''

# Konuşma stili; yalnızca gpt-4o-mini-tts dikkate alır.
#   varsayılan: ''   ·   okuyan: openai_tts_engine.py
OPENAI_TTS_INSTRUCTIONS=''

# "gpt-4o-mini-tts" (kaliteli) veya "tts-1" (daha düşük gecikme).
#   varsayılan: self.DEFAULT_MODEL   ·   okuyan: openai_tts_engine.py
OPENAI_TTS_MODEL=""

#   varsayılan: str(self.DEFAULT_TIMEOUT_S)   ·   okuyan: openai_tts_engine.py
OPENAI_TTS_TIMEOUT_S=""

#   varsayılan: self.DEFAULT_VOICE   ·   okuyan: openai_tts_engine.py, tts_node.py
OPENAI_TTS_VOICE=""


#   varsayılan: os.environ.get('TTS_VOICE', 'echo')   ·   okuyan: astro_realtime_node.py
REALTIME_VOICE=""

#   varsayılan: '350.0'   ·   okuyan: astro_realtime_node.py, audio_stream_node.py
TTS_BARGE_IN_PROTECTION_MS='350.0'

#   varsayılan: (yok)   ·   okuyan: tts_router.py
TTS_EDGE_SYNTHESIS_TIMEOUT_S=""

# "openai" -> OpenAI Speech API (REST) zincire girer ve Edge-TTS'ten ÖNCE denenir.
# "xtts" -> yerel GPU motoru · "elevenlabs" -> ElevenLabs Flash.
#   varsayılan: 'openai'   ·   okuyan: tts_node.py
TTS_ENGINE='openai'

# TTS_ENGINE başka bir değerdeyken bile OpenAI Speech API motorunu açar.
#   varsayılan: 'false'   ·   okuyan: tts_node.py
ENABLE_OPENAI_REST_TTS='false'

# ── Realtime (konuşma-içeri / konuşma-dışarı) ──────────────────────────
# gpt-realtime-2.1-mini: Realtime ailesinin HIZLI katmanı (6 Tem 2026).
# p95 gecikme en az %25 düşük, ses çıkışı 20 $/M token (gpt-realtime-2.1'de 64).
# gpt-realtime-mini OpenAI tarafından kullanımdan kaldırılıyor, kullanmayın.
#   varsayılan: 'gpt-realtime-2.1-mini'   ·   okuyan: astro_realtime_node.py
REALTIME_MODEL='gpt-realtime-2.1-mini'

# Realtime oturumunun girdi transkripsiyonu. gpt-live-transcribe realtime için
# tasarlanmış düşük gecikmeli akış modelidir ve YALNIZCA Realtime içinde çalışır
# (REST /v1/audio/transcriptions 404 döner). whisper-1 kullanmayın: 1 saniyelik
# saf sinüs tonuna "Altyazı M.K." uyduruyor.
#   varsayılan: 'gpt-live-transcribe'   ·   okuyan: astro_realtime_node.py
REALTIME_TRANSCRIBE_MODEL='gpt-live-transcribe'

# Realtime dışı, dosya tabanlı STT (/v1/audio/transcriptions).
# gpt-transcribe OpenAI'nin 28 Tem 2026'dan beri önerdiği modeldir.
#   varsayılan: 'gpt-transcribe'   ·   okuyan: astro_realtime_node.py
OPENAI_STT_MODEL='gpt-transcribe'

#   varsayılan: '8.0'   ·   okuyan: astro_realtime_node.py
OPENAI_STT_TIMEOUT_S='8.0'

#   varsayılan: 'tr'   ·   okuyan: astro_realtime_node.py, tts_node.py
TTS_LANGUAGE='tr'

#   varsayılan: ''   ·   okuyan: local_offline_tts_engine.py
TTS_PIPER_MODEL=''

#   varsayılan: str(self.DEFAULT_DEADLINE_MS)   ·   okuyan: playback_watchdog.py, tts_router.py
TTS_PLAYBACK_START_DEADLINE_MS=""

#   varsayılan: 'echo'   ·   okuyan: astro_realtime_node.py
TTS_VOICE='echo'

#   varsayılan: '1'   ·   okuyan: xtts_client.py
TTS_XTTS_BATCH_SIZE='1'

#   varsayılan: ''   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_CHECKPOINT=''

#   varsayılan: (yok)   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_CONFIG=""

#   varsayılan: 'cuda'   ·   okuyan: tts_node.py
TTS_XTTS_DEVICE="cuda"

#   varsayılan: '1'   ·   okuyan: tts_node.py
TTS_XTTS_HALF="1"

#   varsayılan: '0'   ·   okuyan: local_xtts_engine.py
TTS_XTTS_ENABLED='0'

#   varsayılan: ''   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_HOME=''

#   varsayılan: '1.0'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_LENGTH_PENALTY='1.0'

#   varsayılan: ''   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_MODEL_DIR=''

#   varsayılan: '1'   ·   okuyan: xtts_client.py
TTS_XTTS_NO_WARMUP='1'

#   varsayılan: '4.0'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_REPETITION_PENALTY='4.0'

#   varsayılan: (yok)   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_SPEAKERS=""

#   varsayılan: ''   ·   okuyan: local_xtts_engine.py, tts_node.py
TTS_XTTS_SPEAKER_WAV=''

#   varsayılan: '1.05'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_SPEED='1.05'

#   varsayılan: '8.0'   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_SYNTHESIS_TIMEOUT_S='8.0'

#   varsayılan: '0.50'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_TEMPERATURE='0.50'

#   varsayılan: '45'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_TOP_K='45'

#   varsayılan: '0.65'   ·   okuyan: xtts_client.py, xtts_worker.py
TTS_XTTS_TOP_P='0.65'

#   varsayılan: '2.5'   ·   okuyan: xtts_client.py
TTS_XTTS_TTFA_TIMEOUT_S='2.5'

#   varsayılan: (yok)   ·   okuyan: local_xtts_engine.py, xtts_client.py
TTS_XTTS_VOCAB=""

#   varsayılan: '60.0'   ·   okuyan: local_xtts_engine.py
XTTS_COOLDOWN_S='60.0'

#   varsayılan: '120.0'   ·   okuyan: local_xtts_engine.py
XTTS_DEGRADED_RETRY_S='120.0'

#   varsayılan: '20.0'   ·   okuyan: local_xtts_engine.py
XTTS_FIRST_RETRY_S='20.0'

#   varsayılan: '10'   ·   okuyan: local_xtts_engine.py
XTTS_MAX_ADMISSION_RETRIES='10'

#   varsayılan: '10.0'   ·   okuyan: memory_guard.py
XTTS_MAX_MEM_PSI_FULL_AVG60='10.0'

#   varsayılan: '80.0'   ·   okuyan: memory_guard.py
