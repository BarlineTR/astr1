# ASTRO V1 - Yapay Zeka Ayarlari
# Bu dosyayi '.env' olarak kopyalayin ve icerigini doldurun.

# ==========================================
# 🤖 AI MOD & UYANDIRMA AYARLARI
# ==========================================
# "local" = API çağrısı yapılmaz, sadece STT test modu (varsayılan)
# "api"   = Gemini/OpenAI API'ye bağlanır, tam AI asistan olarak çalışır
AI_MODE="api"

# Robotun sadece bu kelimeyi duyduğunda uyanmasını sağlar
WAKE_WORD="hey astro"

# Sohbetin ne kadar süre açık kalacağı (saniye). 15 saniye idealdir.
CONVERSATION_TIMEOUT=15

# ==========================================
# 🧠 LLM API AYARLARI (AI_MODE="api" için gerekli)
# ==========================================
# Hangi sağlayıcı sohbeti yürütsün? "gemini" (Google, varsayılan) veya "groq"
LLM_PROVIDER="gemini"

# Görsel sorular (kamera) hangi sağlayıcıya gitsin? Boşsa LLM_PROVIDER kullanılır.
VISION_PROVIDER=""

# 1. GOOGLE GEMINI (LLM_PROVIDER="gemini")
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model adı — boş bırakılırsa hesabınızın erişebildiği en güncel flash model
# API'ye sorulup otomatik seçilir (örn. "gemini-2.5-flash").
LLM_MODEL=""

# 2. GROQ (LLM_PROVIDER="groq")
GROQ_API_KEY=""

# Her iki sağlayıcı için ortak üretim ayarları
LLM_TEMPERATURE=0.55
# Düşünme (thinking) tokenları da bu bütçeden düşülür; 300 çok düşük kalıp
# cevabı cümle ortasında kesiyordu.
LLM_MAX_TOKENS=1000

# Gemini REST metin modelleri (ai_brain_node), sırayla denenir — ilk yanıt veren kullanılır.
# "-latest" takma adları her projede çözülür; sürüm numaralı adlar (gemini-2.5-flash)
# bazı anahtarlarda 404 döndürüyor.
GEMINI_TEXT_MODELS="gemini-flash-lite-latest,gemini-flash-latest,gemini-3.6-flash"

# Gemini REST okuma zaman aşımı (sn). Eskiden 5 sn sabitti ve yavaş yanıt veren
# modeller boşuna eleniyordu.
GEMINI_TIMEOUT_S=12
# Gemini 3.x düşünme derinliği: "low" (hızlı, varsayılan) | "high" | "off"
LLM_THINKING="low"

# ==========================================
# 🎤 SPEECH TO TEXT (STT) AYARLARI
# ==========================================
# Hangi motoru kullanmak istiyorsunuz? Seçenekler: "vosk", "whisper" (API), "faster-whisper" (Local)
STT_ENGINE="faster-whisper"

# 1. YEREL VOSK KULLANIMI:
STT_VOSK_MODEL_PATH="vosk-model-small-tr-0.3"

# 2. WHISPER API KULLANIMI (Bulut STT):
STT_API_KEY="sk-BURAYA-WHISPER-API-ANAHTARINIZI-YAZIN"
STT_BASE_URL="https://api.openai.com/v1"
STT_WHISPER_MODEL="whisper-1"

# 3. YEREL FASTER-WHISPER KULLANIMI:
# Seçenekler: "large-v3" (en iyi Türkçe), "medium", "small", "base", "tiny"
# UYARI: "distil-*" modelleri (distil-large-v3 vb.) SADECE İNGİLİZCEDİR.
# language="tr" verilse bile Türkçe üretmez, İngilizce çıktı döner. Kullanmayın.
# Cihaz: "cuda" (NVIDIA GPU / Jetson için önerilir) veya "cpu"
STT_FW_MODEL="large-v2"
STT_FW_DEVICE="cuda"
STT_FW_COMPUTE_TYPE="float16" # "float16", "int8_float16", "int8"
STT_FW_CPU_COMPUTE_TYPE="int8" # CUDA yoksa otomatik CPU'ya düşer

# ==========================================
# 🔊 TEXT TO SPEECH (TTS) AYARLARI
# ==========================================
# Seçenekler: "elevenlabs" (Çok Doğal / Bulut), "edge-tts" (Doğal / İnternetli),
#             "xtts" (Ses klonlama / Yerel / GPU), "pyttsx3" (Robotik / Çevrimdışı), "gtts"
TTS_ENGINE="edge-tts"

# Edge TTS Ses Seçenekleri: 
# Erkek: "tr-TR-AhmetNeural" | Kadın: "tr-TR-EmelNeural"
TTS_VOICE="tr-TR-AhmetNeural"

# ElevenLabs Ses Seçenekleri (Flash v2.5 ~75ms Türkçe Düşük Gecikmeli Ses):
# Şu an ücretsiz planda 402 paid_plan_required verdiği için varsayılan olarak "false" (kapalı) tutun.
ELEVENLABS_ENABLED="false"
ELEVENLABS_API_KEY="" # https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_VOICE_ID="" # 'python3 -m astro_audio.elevenlabs_engine --list-voices' ile bulunabilir
ELEVENLABS_MODEL="eleven_flash_v2_5" # Flash v2.5 (En Hızlı Türkçe / ~75ms) veya 'eleven_multilingual_v2'

# XTTS (yerel ses klonlama, internet gerekmez) — TTS_ENGINE="xtts" için
# Kurulum PyPI'dan DEĞİL, GitHub'dan yapılır ve kendi venv'ini kullanır:
#     ./scripts/install_xtts.sh
TTS_XTTS_HOME="$HOME/.astro/tts"   # install_xtts.sh'ın klonladığı dizin
TTS_XTTS_SPEAKER_WAV=""            # örn: "/home/okistech/Desktop/astr1/models/xtts_finetune_ready_v2/reference.wav"
TTS_XTTS_DEVICE="cuda"             # "auto" | "cuda" | "cpu"
TTS_XTTS_HALF=1                    # 1 = fp16 (yalnızca CUDA'da; ~1.5x hız, yarı VRAM)
TTS_XTTS_BATCH_SIZE=4              # uzun metinde cümleleri toplu çöz; 1 = kapalı
TTS_XTTS_TIMEOUT_S=120             # tek cümle sentez üst sınırı
TTS_XTTS_STARTUP_TIMEOUT_S=300     # model yükleme/indirme üst sınırı

# --- XTTS Gelişmiş Ses Tonu Ayarları (Coqui "Advanced settings" paneli) ---
# Bu değerler worker'a başlangıç argümanı olarak geçer; xtts_client isterse tek tek
# sentez isteğinde de gönderebilir (istek değeri buradakini ezer).
#
# Duygu/tonlama çeşitliliği. Düşük = daha sakin, tekdüze, kararlı; yüksek = daha
# canlı, vurgulu ama zaman zaman tuhaf telaffuz. Aralık 0-1.
TTS_XTTS_TEMPERATURE="0.50"
#
# Modelin uzun mu kısa mı ses üretmeye eğilimli olduğunu belirler. Pozitif değer
# daha uzun/yayvan, negatif değer daha kısa/aceleci konuşma üretir. Aralık -10..10.
TTS_XTTS_LENGTH_PENALTY="1.0"
#
# Tekrar cezası. Düşük tutulursa model heceleri/kelimeleri takılıp tekrar edebilir
# ("me-me-merhaba"); çok yükseltilirse tonlama düzleşir. Aralık 1-10.
TTS_XTTS_REPETITION_PENALTY="4.0"
#
# Her adımda değerlendirilen aday ses jetonu sayısı. Düşük = daha güvenli ve
# tutarlı, yüksek = daha doğal ama daha riskli. Aralık 1-100.
TTS_XTTS_TOP_K="45"
#
# Olasılık kütlesi eşiği (nucleus sampling). Düşürmek sesi sakinleştirir ve
# hatayı azaltır, yükseltmek ifade zenginliğini artırır. Aralık 0-1.
TTS_XTTS_TOP_P="0.65"
#
# Konuşma hızı çarpanı. 1.0 = normal, 1.05 = hafif hızlı, 0.9 = ağır/tok. Aralık 0.5-2.0.
TTS_XTTS_SPEED="1.05"
#
# XTTS'in metni kendi içinde cümlelere bölmesi. ASTRO zaten cümle parçalayıcı
# (sentence chunker) kullandığı için "false" olmalı; "true" yaparsanız çift bölme
# olur ve ilk sesin gecikmesi (TTFA) artar.
TTS_XTTS_TEXT_SPLITTING="false"

# Kendi eğittiğiniz fine-tuned XTTS modeli (isteğe bağlı).
# Boş bırakılırsa hazır tts_models/multilingual/multi-dataset/xtts_v2 indirilip kullanılır.
# Klasör verirseniz dosyalar şu adlarla aranır:
#   model.pth · config.json · vocab.json · speakers_xtts.pth (bu sonuncusu isteğe bağlı)
TTS_XTTS_MODEL_DIR=""              # örn: "/home/kullanici/models/xtts_finetune_ready_v2"
# Dosyalar farklı adlarda/yerlerdeyse tek tek verin (MODEL_DIR'den gelenleri ezer):
TTS_XTTS_CHECKPOINT=""             # örn: ".../model.pth"
TTS_XTTS_CONFIG=""                 # örn: ".../config.json"
TTS_XTTS_VOCAB=""                  # örn: ".../vocab.json"
TTS_XTTS_SPEAKERS=""               # örn: ".../speakers_xtts.pth"

# --- XTTS Bellek Kabul Kontrolü (memory_guard) ---
# XTTS worker'ı başlatmadan önce sistemin belleği yeterli mi diye bakılır. Amaç,
# Jetson gibi paylaşımlı bellekli kartlarda Linux OOM killer'ın devreye girmesini
# önlemek. Reddedilirse yerel offline TTS (eSpeak) devreye girer.

# Bu değerin altında boş RAM varsa XTTS başlatılmaz (MB).
XTTS_MIN_AVAILABLE_RAM_MB="1800.0"

# RAM doluluk oranı üst sınırı (%).
XTTS_MAX_RAM_USED_PERCENT="85.0"

# Çekirdeğin bildirdiği bellek duraklama oranı (/proc/pressure/memory "full avg60").
# Son 60 saniyede tüm görevlerin bellek beklerken durduğu sürenin yüzdesi —
# anlık baskının en doğrudan ölçüsü. Çekirdekte PSI yoksa bu kural atlanır.
XTTS_MAX_MEM_PSI_FULL_AVG60="10.0"

# Takas doluluk üst sınırı (%). DİKKAT: bu değer TEK BAŞINA reddetme sebebi değildir.
# Linux takasa yazdığı soğuk sayfaları RAM sonradan boşalsa bile geri çekmez, bu yüzden
# uzun süredir açık bir sistemde takas doluluğu kalıcı olarak yüksek kalır ve anlık
# baskıyı göstermez. Reddetmek için sistemin o an fiilen takastan sayfa okuyor olması
# da gerekir (aşağıdaki eşik).
XTTS_MAX_SWAP_USED_PERCENT="80.0"

# Takas kuralının tetiklenmesi için gereken asgari takas okuma hızı (sayfa/sn).
XTTS_MIN_SWAP_IN_PAGES_PER_S="100.0"

# --- Reddedilme sonrası kendini toparlama ---
# Kabul reddi kalıcı DEĞİLDİR: açılışta kamera/ONNX/Whisper aynı anda yüklenirken
# ölçülen bellek tepe noktası yüzünden reddedilen XTTS, bellek boşalınca geri gelir.

# İlk yeniden deneme gecikmesi (sn) — açılış telaşının geçmesini bekler.
XTTS_FIRST_RETRY_S="20.0"

# Sonraki yeniden denemelerin aralığı (sn).
XTTS_DEGRADED_RETRY_S="120.0"

# Toplam yeniden deneme sayısı (0 = sınırsız). Sınır, "retry storm" oluşmasını önler.
XTTS_MAX_ADMISSION_RETRIES="10"

# Worker çöktüğünde beklenen süre (sn); bu süre sonunda otomatik yeniden denenir.
XTTS_COOLDOWN_S="60.0"

# ==========================================
# 👤 KONUŞMACI VE SES TANIMA (Speaker Recognition)
# ==========================================
SPEAKER_MODEL_DIR="$HOME/.astro/models"            # speaker_resnet34.onnx konumu
SPEAKER_DB_PATH="$HOME/.astro/voices/speakers.json" # kayıtlı ses profilleri
SPEAKER_MATCH_THRESHOLD="0.40"                    # Baran / bilinen kişi tanıma eşiği

# ==========================================
# 🎚️ SES YAKALAMA VE AKUSTİK YANKI KORUMASI (Acoustic Echo & Barge-In)
# ==========================================
# Mikrofon otomatik seçilir: önce ReSpeaker aranır, yoksa sistemin varsayılan
# girişi kullanılır (seçilen cihaz açılamazsa da varsayılana düşülür).
# Sabitlemek isterseniz indeks ("12") veya ad parçası ("ReSpeaker", "HDA Intel") yazın.
AUDIO_INPUT_DEVICE=""

# Hoparlör çıkışı (tts_node / audio_output_manager). Boşsa önce ReSpeaker aranır,
# bulunamazsa listedeki İLK çıkış cihazı seçilir — bu çoğu masaüstü/dizüstüde HDMI
# olur ve 16 kHz mono akışı reddeder ("Invalid sample rate"). ReSpeaker yoksa
# "pulse" (veya "default") yazın: PipeWire/PulseAudio yeniden örnekleme yapar.
AUDIO_OUTPUT_DEVICE=""

# Çalma arka ucu: "auto" | "sounddevice" | "aplay".
# "auto" (varsayılan) PulseAudio/PipeWire köprüsü (pulse, pipewire, default...) seçiliyse
# aplay'e düşer: bu köprü üzerinden açılan kalıcı PortAudio çıkış akışı, başka bir süreç
# mikrofon tutarken Pa_WriteStream içinde kilitleniyor (ilk tampon duyulup sonrası susuyor).
# Gerçek donanım (ReSpeaker vb.) seçiliyse düşük gecikmeli doğrudan akış kullanılır.
AUDIO_OUTPUT_BACKEND="auto"

# Robotun kendi sesini duymasını (Self-Voice Echo) önleme süresi (saniye):
ECHO_MUTE_COOLDOWN_S="0.65"

# Hoparlör çalarken araya girme (Barge-In) dinamik enerji eşikleri:
BARGE_IN_MIN_RMS="1200.0"
BARGE_IN_NOISE_MULTIPLIER="3.5"
BARGE_IN_MIN_PEAK="2800"

# ==========================================
# 👁️ OLAY GÜDÜMLÜ GÖRSEL ALGI (Event-Driven Vision Gating)
# ==========================================
ENABLE_IDLE_LEARNING="true"           # Boşta hafıza pekiştirme (kamera çağrısı yapmaz, 0 Gemini maliyeti)
VISION_COOLDOWN_S="10.0"              # Aynı sahne/olay için minimum bekleme süresi (saniye)
MAX_VISION_REQUESTS_PER_MINUTE="4"    # Dakika başına maksimum görsel istek bütçesi (RPM üst sınırı)
