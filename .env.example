# Yerel geliştirme ayarları örneği.
# Kopyalayın: cp .env.example .env.local
#
# .env.local depoya girmez (.gitignore).

# ── Veritabanı ──
# Yerelde: docker compose -f docker/compose.yaml up -d
# Port 5433, çünkü 5432'de başka bir Postgres olabilir ve sessizce yanlış
# veritabanına bağlanmak bağlanamamaktan kötü.
DATABASE_URL=postgres://astro:astro@localhost:5433/astro

# ── Oturum ──
# Üretimde rastgele ve gizli olmalı: openssl rand -base64 32
BETTER_AUTH_SECRET=gelistirme-icin-sabit-deger-uretimde-degistirin
BETTER_AUTH_URL=http://localhost:3000

# ── Site ──
# Canonical, sitemap ve OG adresleri buradan türetilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── E-posta (Resend) ──
# Boş bırakılırsa e-postalar konsola yazılır ve bunu açıkça söyler.
# Geliştirmede sessizce başarısız olan bir e-posta, çalıştığını sanmaktan kötü.
RESEND_API_KEY=
EPOSTA_GONDEREN="ASTRO <bildirim@example.invalid>"
EPOSTA_ALICI=iletisim@example.invalid
