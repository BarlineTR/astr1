XTTS_MIN_SWAP_IN_PAGES_PER_S='100.0'

#   varsayılan: '60.0'   ·   okuyan: astro_realtime_node.py
XTTS_STARTUP_GRACE_S='60.0'


# ==========================================================================
# 👁️ ALGI — Yüz tanıma, ses kimliği, bakış ve görsel akıl yürütme
# ==========================================================================
#   varsayılan: '~/.astro/faces/faces.json'   ·   okuyan: face_db.py
FACE_DB_PATH='~/.astro/faces/faces.json'

# Yüz eşleşme kosinüs eşiği. Kişi başına 2-3 fotoğrafla 0.40'a inilebilir.
#   varsayılan: '0.45'   ·   okuyan: face_db.py, face_recognizer.py
FACE_MATCH_THRESHOLD='0.45'

#   varsayılan: '~/.astro/models'   ·   okuyan: face_db.py
FACE_MODEL_DIR='~/.astro/models'

#   varsayılan: '60.0'   ·   okuyan: ai_brain_node.py
GAZE_COOLDOWN_S='60.0'

#   varsayılan: '4.0'   ·   okuyan: ai_brain_node.py
GAZE_DWELL_S='4.0'

#   varsayılan: '15.0'   ·   okuyan: ai_brain_node.py
GAZE_STARTUP_GRACE_S='15.0'

#   varsayılan: '~/.astro/voices/speakers.json'   ·   okuyan: speaker_db.py
SPEAKER_DB_PATH='~/.astro/voices/speakers.json'

# Ses eşleşme eşiği. Kişi başına 3-5 kayıt önerilir.
#   varsayılan: '0.32'   ·   okuyan: astro_realtime_node.py, speaker_db.py
SPEAKER_MATCH_THRESHOLD='0.32'

#   varsayılan: '~/.astro/models'   ·   okuyan: speaker_db.py
SPEAKER_MODEL_DIR='~/.astro/models'

#   varsayılan: '10.0'   ·   okuyan: astro_realtime_node.py
VISION_COOLDOWN_S='10.0'

#   varsayılan: 'llama-3.2-90b-vision-preview'   ·   okuyan: ai_brain_node.py
VISION_MODEL='llama-3.2-90b-vision-preview'

