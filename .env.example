# ASTRO V1 - Yapay Zeka Ayarlari
# Bu dosyayi '.env' olarak kopyalayin ve icerigini doldurun.

# ==========================================
# 🤖 AI MOD & UYANDIRMA AYARLARI
# ==========================================
# "local" = API çağrısı yapılmaz, sadece STT test modu (varsayılan)
# "api"   = Gemini/OpenAI API'ye bağlanır, tam AI asistan olarak çalışır
AI_MODE="api"

# Robotun sadece bu kelimeyi duyduğunda uyanmasını sağlar
WAKE_WORD="hey astro"

# Sohbetin ne kadar süre açık kalacağı (saniye). 15 saniye idealdir.
CONVERSATION_TIMEOUT=15

# ==========================================
# 🧠 LLM API AYARLARI (AI_MODE="api" için gerekli)
# ==========================================
# Hangi sağlayıcı sohbeti yürütsün? "gemini" (Google, varsayılan) veya "groq"
LLM_PROVIDER="gemini"

# Görsel sorular (kamera) hangi sağlayıcıya gitsin? Boşsa LLM_PROVIDER kullanılır.
VISION_PROVIDER=""

# 1. GOOGLE GEMINI (LLM_PROVIDER="gemini")
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model adı — boş bırakılırsa hesabınızın erişebildiği en güncel flash model
# API'ye sorulup otomatik seçilir (örn. "gemini-2.5-flash").
LLM_MODEL=""

# 2. GROQ (LLM_PROVIDER="groq")
GROQ_API_KEY=""

# Her iki sağlayıcı için ortak üretim ayarları
LLM_TEMPERATURE=0.55
# Düşünme (thinking) tokenları da bu bütçeden düşülür; 300 çok düşük kalıp
# cevabı cümle ortasında kesiyordu.
LLM_MAX_TOKENS=1000
# Gemini 3.x düşünme derinliği: "low" (hızlı, varsayılan) | "high" | "off"
LLM_THINKING="low"

# ==========================================
# 🎤 SPEECH TO TEXT (STT) AYARLARI
# ==========================================
# Hangi motoru kullanmak istiyorsunuz? Seçenekler: "vosk", "whisper" (API), "faster-whisper" (Local)
STT_ENGINE="faster-whisper"

# 1. YEREL VOSK KULLANIMI:
STT_VOSK_MODEL_PATH="vosk-model-small-tr-0.3"

# 2. WHISPER API KULLANIMI (Bulut STT):
STT_API_KEY="sk-BURAYA-WHISPER-API-ANAHTARINIZI-YAZIN"
STT_BASE_URL="https://api.openai.com/v1"
STT_WHISPER_MODEL="whisper-1"

# 3. YEREL FASTER-WHISPER KULLANIMI:
# Seçenekler: "large-v3" (en iyi Türkçe), "medium", "small", "base", "tiny"
# UYARI: "distil-*" modelleri (distil-large-v3 vb.) SADECE İNGİLİZCEDİR.
# language="tr" verilse bile Türkçe üretmez, İngilizce çıktı döner. Kullanmayın.
# Cihaz: "cuda" (NVIDIA GPU / Jetson için önerilir) veya "cpu"
STT_FW_MODEL="large-v2"
STT_FW_DEVICE="cuda"
STT_FW_COMPUTE_TYPE="float16" # "float16", "int8_float16", "int8"
STT_FW_CPU_COMPUTE_TYPE="int8" # CUDA yoksa otomatik CPU'ya düşer

# ==========================================
# 🔊 TEXT TO SPEECH (TTS) AYARLARI
# ==========================================
# Seçenekler: "elevenlabs" (Çok Doğal / Bulut), "edge-tts" (Doğal / İnternetli),
#             "xtts" (Ses klonlama / Yerel / GPU), "pyttsx3" (Robotik / Çevrimdışı), "gtts"
TTS_ENGINE="edge-tts"

# Edge TTS Ses Seçenekleri: 
# Erkek: "tr-TR-AhmetNeural" | Kadın: "tr-TR-EmelNeural"
TTS_VOICE="tr-TR-AhmetNeural"

# ElevenLabs Ses Seçenekleri (Flash v2.5 ~75ms Türkçe Düşük Gecikmeli Ses):
# Şu an ücretsiz planda 402 paid_plan_required verdiği için varsayılan olarak "false" (kapalı) tutun.
ELEVENLABS_ENABLED="false"
ELEVENLABS_API_KEY="" # https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_VOICE_ID="" # 'python3 -m astro_audio.elevenlabs_engine --list-voices' ile bulunabilir
ELEVENLABS_MODEL="eleven_flash_v2_5" # Flash v2.5 (En Hızlı Türkçe / ~75ms) veya 'eleven_multilingual_v2'

# XTTS (yerel ses klonlama, internet gerekmez) — TTS_ENGINE="xtts" için
# Kurulum PyPI'dan DEĞİL, GitHub'dan yapılır ve kendi venv'ini kullanır:
#     ./scripts/install_xtts.sh
TTS_XTTS_HOME="$HOME/.astro/tts"   # install_xtts.sh'ın klonladığı dizin
TTS_XTTS_SPEAKER_WAV=""            # boşsa pakete gömülü voices/astro.wav kullanılır
TTS_XTTS_DEVICE="auto"             # "auto" | "cuda" | "cpu"
TTS_XTTS_HALF=1                    # 1 = fp16 (yalnızca CUDA'da; ~1.5x hız, yarı VRAM)
TTS_XTTS_BATCH_SIZE=4              # uzun metinde cümleleri toplu çöz; 1 = kapalı
TTS_XTTS_TIMEOUT_S=120             # tek cümle sentez üst sınırı
TTS_XTTS_STARTUP_TIMEOUT_S=300     # model yükleme/indirme üst sınırı

# Kendi eğittiğiniz XTTS modeli (isteğe bağlı).
# Boş bırakılırsa hazır tts_models/multilingual/multi-dataset/xtts_v2 indirilip kullanılır.
# Klasör verirseniz dosyalar şu adlarla aranır:
#   model.pth · config.json · vocab.json · speakers_xtts.pth (bu sonuncusu isteğe bağlı)
TTS_XTTS_MODEL_DIR=""              # örn: "/home/kullanici/Downloads/optimized_model"
# Dosyalar farklı adlarda/yerlerdeyse tek tek verin (MODEL_DIR'den gelenleri ezer):
TTS_XTTS_CHECKPOINT=""
TTS_XTTS_CONFIG=""
TTS_XTTS_VOCAB=""
TTS_XTTS_SPEAKERS=""

# ==========================================
# 🎚️ SES YAKALAMA (audio_capture_node)
# ==========================================
# Mikrofon otomatik seçilir: önce ReSpeaker aranır, yoksa sistemin varsayılan
# girişi kullanılır (seçilen cihaz açılamazsa da varsayılana düşülür).
# Sabitlemek isterseniz indeks ("12") veya ad parçası ("ReSpeaker", "HDA Intel") yazın.
AUDIO_INPUT_DEVICE=""
