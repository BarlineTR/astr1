{
  "name": "astro-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=@astro/gateway",
    "start": "npm run start --workspace=@astro/gateway",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "dev:gateway": "npm run dev --workspace=@astro/gateway",
    "start:gateway": "npm run start --workspace=@astro/gateway"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
