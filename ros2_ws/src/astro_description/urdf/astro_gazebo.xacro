<?xml version="1.0"?>
<!--
  ASTRO V1 — Gazebo Harmonic (gz-sim 8) simülasyon katmanı

  YALNIZCA sim_mode:=true iken astro.urdf.xacro tarafından dahil edilir.
  Gerçek robotta bu dosyadaki hiçbir şey yüklenmez; oradaki odom/scan/imu
  verisi serial_bridge ve rplidar sürücüsünden gelir.

  Sürüm notu: eklenti dosya adları gz-sim 8 (Harmonic) içindir
  ("gz-sim-*-system"). Gazebo Classic'in "libgazebo_ros_*.so" adları ve
  Ignition Fortress'in "ignition-gazebo6-*" adları burada ÇALIŞMAZ.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ══════════════ Malzeme ve sürtünme ══════════════ -->
  <!-- Lastik: yüksek sürtünme, kayma olmasın. Denge küreleri: neredeyse
       sürtünmesiz, aksi hâlde robot dönerken sürüklenir ve odometri kayar. -->
  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_surface link="left_wheel_link"/>
  <xacro:wheel_surface link="right_wheel_link"/>

  <!-- Döner teker artık yuvarlanıyor, sürüklenmiyor: gerçek lastik gibi
       tutunabilir. Düşük sürtünmeye gerek yok. -->
  <xacro:macro name="caster_surface" params="link">
    <gazebo reference="${link}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:caster_surface link="front_caster_wheel_link"/>
  <xacro:caster_surface link="rear_caster_wheel_link"/>

  <gazebo reference="base_link">
    <material>
      <ambient>0.5 0.5 0.5 1</ambient>
      <diffuse>0.5 0.5 0.5 1</diffuse>
    </material>
  </gazebo>

  <!-- ══════════════ Diferansiyel sürüş ══════════════ -->
  <!-- odom -> base_footprint tf'ini ve /odom'u bu eklenti üretir.
       Gerçek robotta aynı işi serial_bridge yapar; ikisi asla birlikte
       çalışmaz, yoksa tf ağacında iki yayıncı çakışır. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Tekerlek ve kafa eklemlerinin açılarını /joint_states olarak yayınlar,
       robot_state_publisher bunlardan tf üretir. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>head_yaw_joint</joint_name>
      <joint_name>front_caster_swivel_joint</joint_name>
      <joint_name>front_caster_wheel_joint</joint_name>
      <joint_name>rear_caster_swivel_joint</joint_name>
      <joint_name>rear_caster_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Kafa yaw eklemini konum komutuyla sürmek için (/head_yaw_cmd) -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>head_yaw_joint</joint_name>
      <topic>head_yaw_cmd</topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>
  </gazebo>

  <!-- ══════════════ LiDAR (RPLIDAR A1 taklidi) ══════════════ -->
  <!-- Gerçek A1: 360°, ~8 kHz örnekleme, 0.15–12 m, 5.5 Hz.
       samples=720 -> 0.5° çözünürlük. gz_frame_id, LaserScan mesajının
       frame_id'sini laser_frame yapar; olmazsa Gazebo kendi iç adını
       ("astro/base_link/lidar") yazar ve tf araması başarısız olur. -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ══════════════ IMU ══════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ══════════════ OAK-D Lite RGB kamera ══════════════ -->
  <!-- Gerçek düğümlerle aynı topic'e yayınlar (/oak/rgb/image_raw), böylece
       face_detector_node simülasyonda da değişiklik gerektirmez. -->
  <gazebo reference="oak_link">
    <sensor name="oak_rgb" type="camera">
      <topic>oak/rgb/image_raw</topic>
      <gz_frame_id>oak_rgb_camera_optical_frame</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
        <optical_frame_id>oak_rgb_camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</robot>
